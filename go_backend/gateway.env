# 可提交到仓库的网关默认配置（开发/联调用）
# 优先级说明：环境变量 > .env > gateway.env > 代码默认值

# API gateway listen address
GATEWAY_ADDR=:8080

# Existing Python web app address
UPSTREAM_BASE_URL=http://127.0.0.1:5000
UPSTREAM_HEALTH_PATH=/healthz

# JWT auth settings
AUTH_ENABLED=true
AUTH_SIGNING_KEY=spottruth-dev-signing-key
AUTH_ISSUER=spottruth-api-gateway
AUTH_ACCESS_TTL=30m
AUTH_USER_ACCOUNT=spottruth_user
AUTH_USER_PASSWORD=spottruth_user_123
AUTH_USER_ID=u-spottruth-user
AUTH_ADMIN_ACCOUNT=spottruth_admin
AUTH_ADMIN_PASSWORD=spottruth_admin_123
AUTH_ADMIN_ID=u-spottruth-admin
AUTH_SYSTEM_ACCOUNT=spottruth_system
AUTH_SYSTEM_PASSWORD=spottruth_system_123
AUTH_SYSTEM_ID=s-spottruth-system

# HTTP server settings
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# High concurrency settings
MAX_IN_FLIGHT=2048
MAX_IDLE_CONNS=512
MAX_IDLE_CONNS_PER_HOST=256
IDLE_CONN_TIMEOUT=90s
TLS_HANDSHAKE_TIMEOUT=5s
DIAL_TIMEOUT=3s
EXPECT_CONTINUE_TIMEOUT=1s
RESPONSE_HEADER_TIMEOUT=15s
LIMITER_RETRY_AFTER_SECONDS=1

# Bucket limiter settings
BUCKET_LIMIT_ENABLED=true
BUCKET_LIMIT_REQUESTS=120
BUCKET_LIMIT_WINDOW=1m
BUCKET_LIMIT_RETRY_AFTER_SECONDS=5
BUCKET_LIMIT_PREFER_API_KEY=true

# Circuit breaker settings
CB_ENABLED=true
CB_MAX_REQUESTS=3
CB_INTERVAL=10s
CB_TIMEOUT=15s
CB_MIN_REQUESTS=5
CB_ERROR_RATE_THRESHOLD=50
CB_RETRY_AFTER_SECONDS=3
